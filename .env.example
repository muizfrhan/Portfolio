# Portfolio Contact — Environment Variables
# Salin file ini menjadi .env (lokal) atau isi di Vercel Dashboard → Settings → Environment Variables
# JANGAN commit .env yang berisi credential asli.

# Email tujuan — SEMUA pesan Contact Form akan dikirim ke alamat ini
# WAJIB diisi dengan email pemilik portfolio:
CONTACT_EMAIL=mfarhanmuizaddin@gmail.com

# Resend API Key — buat di https://resend.com/api-keys
# Harus diawali re_...
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# (Opsional) Alamat pengirim terverifikasi di Resend.
# Jika kosong, akan memakai "Portfolio <onboarding@resend.dev>" (hanya untuk testing, terbatas ke email yang terverifikasi)
# Untuk produksi: verifikasi domain di Resend → ganti menjadi mis. "Portfolio <hello@yourdomain.com>"
RESEND_FROM=Portfolio <onboarding@resend.dev>
